<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F6"
    android:padding="20dp">

    <!-- TITRE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📦  Synthèse des stocks"
        android:textColor="#20B86B"
        android:textSize="25sp"
        android:textStyle="bold"
        android:paddingBottom="20dp" />

    <!-- ZONE DE RECHERCHE -->
    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#FFFFFF"
        android:hint="Saisir Code SAP ou Code OCP"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#222222"
        android:textColorHint="#888888"
        android:textSize="16sp"
        android:singleLine="true"
        android:imeOptions="actionSearch" />

    <!-- BOUTON RECHERCHER -->
    <Button
        android:id="@+id/searchButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="🔍  RECHERCHER"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="#20B86B" />

    <!-- ESPACE -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- INFORMATION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rechercher un article par son Code SAP ou son Code OCP."
        android:textColor="#666666"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="10dp" />

</LinearLayout>
