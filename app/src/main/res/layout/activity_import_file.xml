<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- EN-TÊTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@color/green_primary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Importer des fichiers"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONTENU -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- TITRE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Importation des stocks"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- NOM DU FICHIER -->
            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aucun fichier sélectionné"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- CERCLE DE PROGRESSION -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="28dp"
                android:layout_gravity="center">

                <ProgressBar
                    android:id="@+id/importProgress"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_circle"
                    android:rotation="-90" />

                <TextView
                    android:id="@+id/progressPercent"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:text="0 %"
                    android:textColor="@color/green_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- STATUT -->
            <TextView
                android:id="@+id/progressStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Prêt pour l'importation"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- NOMBRE DE LIGNES -->
            <TextView
                android:id="@+id/rowsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 / 0 lignes"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- BOUTON CHOISIR -->
            <Button
                android:id="@+id/selectFileButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="CHOISIR UN FICHIER"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/green_primary" />

            <!-- BOUTON IMPORTER -->
            <Button
                android:id="@+id/importButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="IMPORTER"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/green_dark"
                android:enabled="false" />

            <!-- BOUTON ANNULER -->
            <Button
                android:id="@+id/cancelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="ANNULER"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/card_background" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
