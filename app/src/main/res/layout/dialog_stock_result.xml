<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="18dp">

    <TextView
        android:id="@+id/dialogDesignation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ARTICLE"
        android:textColor="#20B86B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingBottom="7dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="430dp">

        <TextView
            android:id="@+id/dialogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444444"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:background="#AAAAAA" />

    <TextView
        android:id="@+id/dialogTotalStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📦  TOTAL EN STOCK : 0.00"
        android:textColor="#20B86B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />

    <TextView
        android:id="@+id/dialogGlobalValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💰  VALEUR GLOBALE : 0.00 MAD"
        android:textColor="#20B86B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingTop="3dp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/dialogClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="FERMER"
        android:textColor="#20B86B"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF" />

</LinearLayout>
